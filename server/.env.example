# Server environment variables template.
# Copy to server/.env and fill in real values. Never commit .env.

# Application
NODE_ENV=development
PORT=5000

# JWT secrets - use long random strings in production
JWT_SECRET=change_me_access_secret
REFRESH_TOKEN_SECRET=change_me_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medicore
